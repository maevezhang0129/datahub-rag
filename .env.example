# Everything below is OPTIONAL.
# With no .env at all, the project runs on a local embedding model and needs
# no credentials of any kind.

# --- Database (docker compose sets this automatically) ---
# DATABASE_URL=postgresql://drr:drr@localhost:5432/drr_rag

# --- Retrieval tuning ---
# DRR_CHUNK_TOKENS=512
# DRR_CHUNK_OVERLAP_PCT=25
# DRR_RRF_K=60
# DRR_HYBRID_CANDIDATES=200
# DRR_BM25_MIN_RANK=0.05

# --- Optional: hosted embeddings instead of the local model ---
# DRR_EMBED_MODEL=text-embedding-3-small
# OPENAI_API_KEY=sk-...
#
# ...or Azure OpenAI:
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_API_VERSION=2024-02-01
