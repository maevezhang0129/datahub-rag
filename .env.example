# Everything below is OPTIONAL.
# With no .env at all, the project runs on a local embedding model and a
# deterministic stub chat backend, and needs no credentials of any kind.

# --- Database (docker compose sets this automatically) ---
# DATABASE_URL=postgresql://drr:drr@localhost:5432/datahub_rag

# --- Chunking ---
# DRR_CHUNK_TOKENS=512
# DRR_CHUNK_OVERLAP_PCT=25

# --- Retrieval ---
# DRR_RRF_K=60
# DRR_RRF_WEIGHT_VECTOR=3.0     # measured; 1:1 fusion scores below pure dense
# DRR_RRF_WEIGHT_LEXICAL=1.0
# DRR_BM25_MIN_RANK=0.01
# DRR_HYBRID_CANDIDATES=200

# --- Chat ---
# Calibrated against this corpus AND this embedding model; changing either
# requires re-running `make eval-chat`. See docs/adr/005.
# DATAHUB_MIN_RELEVANCE=0.68

# --- Optional: a real model instead of the stub chat backend ---
# DATAHUB_CHAT_BACKEND=openai
# OPENAI_API_KEY=sk-...

# --- Optional: hosted embeddings instead of the local model ---
# DRR_EMBED_MODEL=text-embedding-3-small
# OPENAI_API_KEY=sk-...
#
# ...or Azure OpenAI, for either of the two above:
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_API_VERSION=2024-02-01
